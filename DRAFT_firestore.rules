rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidMissionLog(data) {
      return data.keys().hasAll([
        'ownerId',
        'astronautName',
        'siteId',
        'solReached',
        'score',
        'oxygenRemaining',
        'radiationMsv',
        'outcome',
        'summaryNote',
        'createdAt'
      ]) &&
      data.keys().hasOnly([
        'ownerId',
        'astronautName',
        'siteId',
        'solReached',
        'score',
        'oxygenRemaining',
        'radiationMsv',
        'outcome',
        'summaryNote',
        'createdAt'
      ]) &&
      data.ownerId is string &&
      data.ownerId.size() >= 1 &&
      data.ownerId.size() <= 128 &&
      data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.ownerId == request.auth.uid &&
      data.astronautName is string &&
      data.astronautName.size() >= 1 &&
      data.astronautName.size() <= 60 &&
      data.siteId is string &&
      data.siteId.size() <= 10 &&
      (data.siteId == 'moon' || data.siteId == 'mars') &&
      data.solReached is int &&
      data.solReached >= 1 &&
      data.solReached <= 7 &&
      data.score is int &&
      data.score >= 0 &&
      data.score <= 100000 &&
      data.oxygenRemaining is int &&
      data.oxygenRemaining >= 0 &&
      data.oxygenRemaining <= 100 &&
      (data.radiationMsv is int || data.radiationMsv is float) &&
      data.radiationMsv >= 0 &&
      data.radiationMsv <= 1000 &&
      data.outcome is string &&
      data.outcome.size() <= 20 &&
      (data.outcome == 'victory' || data.outcome == 'defeat' || data.outcome == 'in_progress') &&
      data.summaryNote is string &&
      data.summaryNote.size() >= 1 &&
      data.summaryNote.size() <= 500 &&
      data.createdAt is timestamp;
    }

    function isValidCustomInstructionProfile(data) {
      return data.keys().hasAll([
        'ownerId',
        'commanderStyle',
        'targetAgeGroup',
        'customRules',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'ownerId',
        'commanderStyle',
        'targetAgeGroup',
        'customRules',
        'updatedAt'
      ]) &&
      data.ownerId is string &&
      data.ownerId.size() >= 1 &&
      data.ownerId.size() <= 128 &&
      data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.ownerId == request.auth.uid &&
      data.commanderStyle is string &&
      data.commanderStyle.size() <= 30 &&
      (data.commanderStyle == 'among_us_crew' ||
       data.commanderStyle == 'nasa_mission_control' ||
       data.commanderStyle == 'story_adventure' ||
       data.commanderStyle == 'science_coach') &&
      data.targetAgeGroup is string &&
      data.targetAgeGroup.size() <= 20 &&
      (data.targetAgeGroup == '7-9' ||
       data.targetAgeGroup == '10-12' ||
       data.targetAgeGroup == 'classroom') &&
      data.customRules is string &&
      data.customRules.size() >= 1 &&
      data.customRules.size() <= 600 &&
      data.updatedAt is timestamp;
    }

    function isValidSoundtrackRecord(data) {
      return data.keys().hasAll([
        'ownerId',
        'title',
        'prompt',
        'mood',
        'bpm',
        'lyrics',
        'createdAt'
      ]) &&
      data.keys().hasOnly([
        'ownerId',
        'title',
        'prompt',
        'mood',
        'bpm',
        'lyrics',
        'createdAt'
      ]) &&
      data.ownerId is string &&
      data.ownerId.size() >= 1 &&
      data.ownerId.size() <= 128 &&
      data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.ownerId == request.auth.uid &&
      data.title is string &&
      data.title.size() >= 1 &&
      data.title.size() <= 80 &&
      data.prompt is string &&
      data.prompt.size() >= 1 &&
      data.prompt.size() <= 300 &&
      data.mood is string &&
      data.mood.size() <= 30 &&
      (data.mood == 'calm_orbit' ||
       data.mood == 'solar_storm_alert' ||
       data.mood == 'hydroponic_zen' ||
       data.mood == 'victory_fanfare') &&
      data.bpm is int &&
      data.bpm >= 60 &&
      data.bpm <= 180 &&
      data.lyrics is string &&
      data.lyrics.size() >= 1 &&
      data.lyrics.size() <= 600 &&
      data.createdAt is timestamp;
    }

    match /missionLogs/{logId} {
      allow get: if isSignedIn() && isValidId(logId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isVerifiedUser() &&
        isValidId(logId) &&
        isValidMissionLog(incoming()) &&
        incoming().createdAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(logId) &&
        isValidMissionLog(incoming()) &&
        existing().ownerId == request.auth.uid &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        existing().outcome == 'in_progress' &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'solReached',
          'score',
          'oxygenRemaining',
          'radiationMsv',
          'outcome',
          'summaryNote'
        ]);
      allow delete: if isVerifiedUser() && isValidId(logId) && existing().ownerId == request.auth.uid;
    }

    match /customInstructions/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && userId == request.auth.uid && existing().ownerId == request.auth.uid;
      allow list: if false;
      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        userId == request.auth.uid &&
        isValidCustomInstructionProfile(incoming()) &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        userId == request.auth.uid &&
        isValidCustomInstructionProfile(incoming()) &&
        existing().ownerId == request.auth.uid &&
        incoming().ownerId == existing().ownerId &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'commanderStyle',
          'targetAgeGroup',
          'customRules',
          'updatedAt'
        ]);
      allow delete: if isVerifiedUser() && isValidId(userId) && userId == request.auth.uid && existing().ownerId == request.auth.uid;
    }

    match /soundtracks/{trackId} {
      allow get: if isSignedIn() && isValidId(trackId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isVerifiedUser() &&
        isValidId(trackId) &&
        isValidSoundtrackRecord(incoming()) &&
        incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isVerifiedUser() && isValidId(trackId) && existing().ownerId == request.auth.uid;
    }
  }
}
